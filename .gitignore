# Environment files
.env
*.env
!*.env.example
!*env-example.txt

# Browser state
storage-state*.json
auth*.json
cookies*.json

# Evidence files (screenshots, etc.)
evidence/**/*.png
evidence/**/*.jpg
evidence/**/*.webp
evidence/**/*.json

# Playwright report and test results
playwright-report/
test-results/

# Playwright MCP snapshot output (generated artifacts, not source)
.playwright-mcp/

# Node.js
node_modules/

# Python generated files
__pycache__/
*.py[cod]
.pytest_cache/

# Evaluation framework results
scripts/evaluation/results/

# Benchmark runner results (never commit generated benchmark output)
scripts/benchmark/results/

# MCP config backups (machine-local, user profile)
.mcp-config-backups/

# IDE and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Disposable local planning notes
PRECOMMIT-DRAFT.md
.cursor/plans/

# Local ephemeral kagent lab captures (never commit)
evidence/kagent/tmp/

# Debug transcripts (diagnostic output from test or CI instrumentation)
debug-*.log
